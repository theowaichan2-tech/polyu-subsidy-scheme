<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>PolyU Design · Subsidy Scheme (All Pages)</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<style>
:root {
  --bg: #f7f4ee;
  --bg-soft: #ebe6dc;
  --bg-cover: #efebe3;
  --bg-cta: #d9e0d4;
  --bg-footer: #efeae2;
  --bg-sidebar: #ece7dd;
  --card: #ffffff;
  --text: #1a1a1a;
  --muted: #6b6560;
  --border: #d9d2c6;
  --primary: #222222;
  --success: #4a5d45;
  --success-soft: #e4ebe2;
  --danger: #8b3a3a;
  --danger-soft: #f3e0e0;
  --warning: #8a5a3a;
  --warning-soft: #f0e4d6;
  --radius: 14px;
  --max: 72rem;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  font-family: "Plus Jakarta Sans", ui-sans-serif, system-ui, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.5;
  min-height: 100vh;
}
a { color: inherit; text-decoration: none; }
img { max-width: 100%; display: block; }
button, input, select, textarea, summary { font: inherit; }
.container { width: min(100% - 2rem, var(--max)); margin-inline: auto; }

.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem;
  min-height: 2.75rem; padding: 0.65rem 1.15rem; border-radius: 0.75rem;
  border: 1px solid transparent; font-size: 0.925rem; font-weight: 500;
  cursor: pointer; transition: 0.15s ease; background: none; color: inherit;
}
.btn-primary { background: var(--primary); color: #fff; }
.btn-primary:hover { background: #111; }
.btn-outline { background: var(--card); border-color: color-mix(in srgb, var(--text) 80%, transparent); }
.btn-outline:hover { background: var(--bg-soft); }
.btn-icon {
  width: 2.5rem; min-height: 2.5rem; padding: 0;
  border: 1px solid var(--border); background: var(--card); border-radius: 0.75rem;
}
.btn:disabled { opacity: 0.45; cursor: not-allowed; }

.eyebrow, .section-label {
  margin: 0; font-size: 11px; font-weight: 600;
  letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted);
}
.section-title { margin: 0.5rem 0 0; font-size: clamp(1.75rem, 3vw, 2rem); letter-spacing: -0.02em; }
.muted { color: var(--muted); }

.badge {
  display: inline-flex; align-items: center; border-radius: 999px;
  padding: 0.25rem 0.65rem; font-size: 11px; font-weight: 700;
  letter-spacing: 0.04em; text-transform: uppercase;
}
.badge-yes, .badge-approved { background: var(--success-soft); color: var(--success); }
.badge-no, .badge-returned, .badge-due { background: var(--danger-soft); color: var(--danger); }
.badge-draft { background: #eceae6; color: #5c5c5c; }
.badge-endorsement, .badge-pending { background: var(--warning-soft); color: var(--warning); }

.card {
  background: var(--card); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 1.25rem;
}

/* Public header */
.site-header {
  position: sticky; top: 0; z-index: 40;
  border-bottom: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
  background: color-mix(in srgb, var(--bg) 95%, transparent);
  backdrop-filter: blur(10px);
}
.site-header__inner { min-height: 72px; display: flex; align-items: center; gap: 1rem; }
.brand-kicker { margin: 0; font-size: 11px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
.brand-title { margin: 0; font-size: 15px; font-weight: 600; }
.nav-desktop { display: none; gap: 1.75rem; margin-left: auto; font-size: 0.925rem; font-weight: 500; }
.nav-desktop a { color: color-mix(in srgb, var(--text) 80%, transparent); }
.header-portal { margin-left: auto; }
.menu-toggle { display: inline-flex; }

.overlay {
  position: fixed; inset: 0; z-index: 50; background: rgba(0,0,0,0.35);
  opacity: 0; pointer-events: none; transition: opacity 0.2s ease;
}
.overlay.is-open { opacity: 1; pointer-events: auto; }
.drawer {
  position: fixed; inset: 0 auto 0 0; z-index: 60; width: min(88vw, 320px);
  background: #f3efe7; box-shadow: 0 20px 50px rgba(0,0,0,0.18);
  transform: translateX(-100%); pointer-events: none; transition: transform 0.2s ease;
  display: flex; flex-direction: column;
}
.drawer.is-open { transform: translateX(0); pointer-events: auto; }
.drawer__top { display: flex; justify-content: space-between; gap: 1rem; padding: 1.25rem; border-bottom: 1px solid var(--border); }
.drawer nav { display: flex; flex-direction: column; gap: 0.25rem; padding: 1rem 0.75rem; }
.drawer nav a { padding: 0.85rem 0.75rem; border-radius: 0.85rem; font-weight: 500; }
.drawer .btn-primary { margin: 0.75rem; }

/* Portal shell */
.portal-header {
  position: sticky; top: 0; z-index: 30;
  border-bottom: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
  background: color-mix(in srgb, #f8f6f1 95%, transparent);
  backdrop-filter: blur(10px);
}
.portal-header__inner {
  min-height: 64px; display: flex; align-items: center; gap: 0.75rem;
  width: min(100% - 2rem, 80rem); margin-inline: auto;
}
.portal-main {
  width: min(100% - 2rem, 80rem); margin-inline: auto;
  padding: 1.5rem 0 3rem;
}
.portal-actions { display: flex; align-items: center; gap: 0.35rem; margin-left: auto; }
.avatar {
  width: 2.25rem; height: 2.25rem; border-radius: 999px;
  background: var(--primary); color: #fff; display: grid; place-items: center;
  font-size: 12px; font-weight: 700;
}

.side-nav {
  position: fixed; inset: 0 auto 0 0; z-index: 50; width: min(88vw, 300px);
  background: var(--bg-sidebar); border-right: 1px solid var(--border);
  transform: translateX(-100%); pointer-events: none; transition: transform 0.2s ease;
  display: flex; flex-direction: column;
}
.side-nav.is-open { transform: translateX(0); pointer-events: auto; }
.side-nav__top { display: flex; justify-content: space-between; gap: 1rem; padding: 1.25rem; border-bottom: 1px solid color-mix(in srgb, var(--border) 70%, transparent); }
.side-nav__user {
  margin: 1rem; display: flex; gap: 0.75rem; align-items: center;
  background: rgba(255,255,255,0.7); border-radius: 1rem; padding: 0.75rem;
}
.side-nav__user .avatar { background: #5b6b52; width: 2.75rem; height: 2.75rem; }
.side-nav nav { flex: 1; padding: 0.5rem 0.75rem; overflow: auto; }
.side-nav nav a {
  display: flex; align-items: center; gap: 0.75rem;
  padding: 0.85rem 0.9rem; border-radius: 1rem; margin-bottom: 0.25rem;
}
.side-nav nav a.active { background: #fff; font-weight: 600; box-shadow: 0 1px 2px rgba(0,0,0,0.04); }
.side-nav nav a:hover { background: rgba(255,255,255,0.55); }
.nav-badge {
  margin-left: auto; background: var(--bg-soft); border-radius: 0.4rem;
  padding: 0.1rem 0.4rem; font-size: 12px; font-weight: 700;
}

/* Landing */
.hero { display: grid; border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent); }
.hero__media { position: relative; min-height: 280px; overflow: hidden; background: #222; }
.hero__media img { width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; }
.hero__content { display: flex; flex-direction: column; justify-content: center; padding: 2.5rem 1rem; }
.hero h1 { margin: 1rem 0 0; font-size: clamp(2rem, 5vw, 3rem); line-height: 1.1; letter-spacing: -0.02em; }
.hero__lead { margin: 1rem 0 0; max-width: 28rem; color: var(--muted); font-size: 1.05rem; }
.hero__actions { margin-top: 2rem; display: flex; flex-direction: column; gap: 0.75rem; }
.stats { background: var(--primary); color: #fff; }
.stats__grid { display: grid; gap: 1.5rem; padding: 2rem 0; }
.stats strong { display: block; font-size: 1.75rem; }
.stats span { display: block; margin-top: 0.25rem; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255,255,255,0.7); }
section.block { padding: 3.5rem 0; }
.steps { display: grid; gap: 2rem; margin-top: 2.5rem; }
.step-num {
  width: 2.5rem; height: 2.5rem; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--text) 20%, transparent);
  display: grid; place-items: center; font-size: 0.875rem; font-weight: 600; background: var(--bg);
}
.step h3 { margin: 1rem 0 0; }
.step p { margin: 0.5rem 0 0; color: var(--muted); font-size: 0.925rem; }
.eligibility { background: var(--bg-soft); }
.eligibility__grid { display: grid; gap: 2.5rem; }
.eligibility__cards { display: grid; gap: 0.75rem; }
.elig-card { background: var(--bg); border: 1px solid color-mix(in srgb, var(--border) 80%, transparent); border-radius: var(--radius); padding: 1rem; }
.elig-card h3 { margin: 0.75rem 0 0; font-size: 1rem; }
.elig-card p { margin: 0.25rem 0 0; color: var(--muted); font-size: 0.925rem; }
.covers { display: grid; gap: 1rem; margin-top: 2rem; }
.cover-card { position: relative; background: var(--bg-cover); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.5rem; }
.cover-card .n { position: absolute; top: 1.25rem; right: 1.25rem; color: var(--muted); }
.cover-icon { width: 2.5rem; height: 2.5rem; border-radius: 999px; background: var(--card); display: grid; place-items: center; margin-bottom: 1rem; }
.levels { margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid var(--border); display: flex; flex-direction: column; gap: 0.75rem; }
.levels__items { display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; font-weight: 500; }
.faq { background: color-mix(in srgb, var(--card) 40%, var(--bg)); border-block: 1px solid color-mix(in srgb, var(--border) 70%, transparent); }
.faq__grid { display: grid; gap: 2.5rem; }
.faq-list { border-block: 1px solid var(--border); }
details { padding: 1rem 0; border-bottom: 1px solid var(--border); }
details:last-child { border-bottom: 0; }
summary { list-style: none; cursor: pointer; font-weight: 600; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
summary::-webkit-details-marker { display: none; }
.faq-toggle {
  width: 2rem; height: 2rem; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--text) 20%, transparent);
  display: grid; place-items: center; flex-shrink: 0;
}
details[open] .faq-toggle { background: var(--primary); color: #fff; border-color: var(--primary); }
details[open] .faq-toggle .plus { display: none; }
details:not([open]) .faq-toggle .minus { display: none; }
details p { margin: 0.75rem 0 0; max-width: 36rem; color: var(--muted); font-size: 0.925rem; }
.cta-box { background: var(--bg-cta); border-radius: 1.5rem; padding: 2.5rem 1.5rem; }
.cta-box .btn { margin-top: 1.5rem; }
footer.site-footer { border-top: 1px solid var(--border); background: var(--bg-footer); padding: 2rem 0; }
.footer__inner { display: flex; flex-direction: column; gap: 1rem; }

/* Portal content helpers */
.page-hero h1 { margin: 0.35rem 0 0; font-size: clamp(1.75rem, 3vw, 2.25rem); }
.grid-2 { display: grid; gap: 0.75rem; }
.grid-3 { display: grid; gap: 0.75rem; }
.stat-card h3 { margin: 0; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
.stat-card .value { margin: 0.75rem 0 0; font-size: 1.75rem; font-weight: 700; }
.stat-card p { margin: 0.5rem 0 0; color: var(--muted); font-size: 0.9rem; }
.list-row {
  display: flex; align-items: center; gap: 0.75rem;
  padding: 1rem 0; border-bottom: 1px solid var(--border);
}
.list-row:last-child { border-bottom: 0; }
.list-row .meta { font-size: 12px; color: var(--muted); }
.tabs { display: flex; gap: 0.25rem; overflow: auto; border-bottom: 1px solid var(--border); margin-bottom: 0.25rem; }
.tabs button {
  background: none; border: 0; border-bottom: 2px solid transparent;
  padding: 0.65rem 0.85rem; cursor: pointer; color: var(--muted); white-space: nowrap;
}
.tabs button.active { color: var(--text); font-weight: 600; border-bottom-color: var(--text); }
.field { display: grid; gap: 0.5rem; margin-bottom: 1rem; }
.field label { font-size: 0.9rem; font-weight: 500; }
.field input, .field select, .field textarea {
  width: 100%; min-height: 2.75rem; border-radius: 0.85rem;
  border: 1px solid color-mix(in srgb, var(--text) 25%, transparent);
  background: var(--card); padding: 0.7rem 0.9rem;
}
.field textarea { min-height: 7rem; resize: vertical; }
.choice-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.65rem; }
.choice {
  display: flex; align-items: center; gap: 0.65rem; text-align: left;
  border: 1px solid color-mix(in srgb, var(--text) 20%, transparent);
  border-radius: 0.85rem; padding: 0.85rem; background: var(--card); cursor: pointer;
}
.choice.is-selected { background: var(--primary); color: #fff; border-color: var(--primary); }
.form-actions {
  position: sticky; bottom: 0; background: color-mix(in srgb, var(--card) 95%, transparent);
  border-top: 1px solid var(--border); padding: 0.85rem 1rem;
  display: flex; align-items: center; gap: 0.75rem; backdrop-filter: blur(8px);
}
.form-actions .center { flex: 1; text-align: center; color: var(--muted); font-size: 0.9rem; }
.stack { display: grid; gap: 1rem; }
.notice { background: var(--bg-soft); border: 1px solid var(--border); border-radius: 0.85rem; padding: 0.85rem 1rem; color: var(--muted); font-size: 0.9rem; }

@media (min-width: 640px) {
  .hero__media { min-height: 360px; }
  .hero__content { padding: 3.5rem 2rem; }
  .hero__actions { flex-direction: row; }
  .stats__grid { grid-template-columns: repeat(3, 1fr); }
  .steps { grid-template-columns: repeat(2, 1fr); }
  .eligibility__cards, .covers, .grid-2 { grid-template-columns: repeat(2, 1fr); }
  .grid-3 { grid-template-columns: repeat(3, 1fr); }
  .levels { flex-direction: row; align-items: center; justify-content: space-between; }
  .cta-box { padding: 2.5rem; }
  .footer__inner { flex-direction: row; align-items: center; justify-content: space-between; }
}

@media (min-width: 1024px) {
  .menu-toggle.public-only { display: none; }
  .nav-desktop { display: flex; }
  .header-portal { margin-left: 1rem; }
  .hero { grid-template-columns: 1fr 1fr; }
  .hero__media { min-height: 480px; }
  .hero__content { padding: 4rem 3rem; }
  .steps { grid-template-columns: repeat(4, 1fr); position: relative; }
  .steps::before { content: ""; position: absolute; left: 0; right: 0; top: 1.25rem; height: 1px; background: var(--border); }
  .eligibility__grid, .faq__grid { grid-template-columns: 0.9fr 1.1fr; }
}

.page { display: none; }
.page.is-active { display: block; }
.page-portal.is-active { display: block; }
.app-shell-hidden { display: none !important; }
body[data-view="home"] .portal-chrome { display: none !important; }
body[data-view="portal"] .public-chrome { display: none !important; }
.spa-toast {
  position: fixed; left: 50%; bottom: 1.25rem; transform: translateX(-50%);
  background: #222; color: #fff; padding: 0.75rem 1rem; border-radius: 999px;
  font-size: 0.9rem; z-index: 100; display: none;
}
.spa-toast.show { display: block; }

</style>
</head>
