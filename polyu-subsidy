<main class="page is-active" id="page-home">
  <section class="hero" id="about">
    <div class="hero__media">
      <img src="data:image/jpeg;base64," alt="Abstract PolyU Design hero graphic" />
    </div>
    <div class="hero__content">
      <p class="eyebrow">PolyU School of Design / Competition/Award Subsidy Scheme</p>
      <h1>Take your design work further.</h1>
      <p class="hero__lead">Financial support for PolyU Design students entering recognised competitions and awards.</p>
      <div class="hero__actions">
        <a class="btn btn-primary" href="#portal" data-nav="portal">Apply through the portal →</a>
        <a class="btn btn-outline" href="#how-it-works" data-nav="home" data-scroll="how-it-works">Explore the scheme</a>
      </div>
    </div>
  </section>

  <section class="stats">
    <div class="container stats__grid">
      <div><strong>2</strong><span>Support types</span></div>
      <div><strong>3</strong><span>Recognition levels</span></div>
      <div><strong>1 month</strong><span>Result reporting</span></div>
    </div>
  </section>

  <section class="block" id="how-it-works">
    <div class="container">
      <p class="section-label">How it works</p>
      <h2 class="section-title">From application to reimbursement.</h2>
      <div class="steps">
        <article class="step"><div class="step-num">01</div><h3>Apply</h3><p>Submit competition, project and requested funding details through the portal.</p></article>
        <article class="step"><div class="step-num">02</div><h3>Review</h3><p>A faculty endorser and the School review your request.</p></article>
        <article class="step"><div class="step-num">03</div><h3>Subsidy</h3><p>Receive the decision and submit eligible receipts for reimbursement.</p></article>
        <article class="step"><div class="step-num">04</div><h3>Report results</h3><p>Report the official outcome within one month of announcement.</p></article>
      </div>
    </div>
  </section>

  <section class="eligibility block" id="eligibility">
    <div class="container eligibility__grid">
      <div>
        <p class="section-label">Eligibility</p>
        <h2 class="section-title">Check before you begin.</h2>
        <p class="muted" style="margin-top:0.75rem;max-width:24rem">Every application should meet these core requirements before you start a draft.</p>
      </div>
      <div class="eligibility__cards">
        <article class="elig-card"><span class="badge badge-yes">Yes</span><h3>Current student</h3><p>You are a current full-time PolyU School of Design student.</p></article>
        <article class="elig-card"><span class="badge badge-yes">Yes</span><h3>Recognised opportunity</h3><p>The competition or award has professional recognition.</p></article>
        <article class="elig-card"><span class="badge badge-yes">Yes</span><h3>Original funding request</h3><p>The entry is not already supported by another scheme.</p></article>
        <article class="elig-card"><span class="badge badge-no">No</span><h3>Exchange student</h3><p>Exchange students are not eligible for this scheme.</p></article>
      </div>
    </div>
  </section>

  <section class="block">
